{
  "name": "@couch-potato/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/theme.css",
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./logo.png": "./src/assets/logo.png",
    "./logo.webp": "./src/assets/logo.webp",
    "./logo-mark.png": "./src/assets/logo-mark.png",
    "./logo-mark.webp": "./src/assets/logo-mark.webp",
    "./logo-celebrate.png": "./src/assets/logo-celebrate.png",
    "./logo-celebrate.webp": "./src/assets/logo-celebrate.webp",
    "./logo-options.png": "./src/assets/logo-options.png",
    "./logo-options.webp": "./src/assets/logo-options.webp",
    "./logo-sprite.png": "./src/assets/logo-sprite.png",
    "./logo-sprite.webp": "./src/assets/logo-sprite.webp",
    "./logo-sprite.json": "./src/assets/logo-sprite.json",
    "./medals-sprite.png": "./src/assets/medals-sprite.png",
    "./medals-sprite.webp": "./src/assets/medals-sprite.webp",
    "./medals-sprite.json": "./src/assets/medals-sprite.json",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "scripts": {
    "optimize-sprites": "bun ./scripts/optimize-sprites.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@couch-potato/game-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "lucide-react": "^1.26.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
