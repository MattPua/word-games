{
  "name": "couch-potato",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "bun run --filter @couch-potato/web dev",
    "mobile": "bun run --filter @couch-potato/mobile start",
    "mobile:web": "bun run --filter @couch-potato/mobile web",
    "build": "bun run --filter @couch-potato/dictionary build && bun run --filter @couch-potato/web build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "check": "oxlint && oxfmt --check",
    "dev": "mprocs",
    "mprocs": "mprocs",
    "sprites:optimize": "bun packages/ui/scripts/optimize-sprites.ts"
  },
  "devDependencies": {
    "mprocs": "0.9.6",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sharp": "^0.35.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6"
  },
  "catalog": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0"
  }
}
